<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/car"
    android:padding="20dp"
    >
    <TextView
        android:id="@+id/ridedetailstitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Ride Details"
        android:textColor="@color/white"
        android:textSize="30dp"
        android:layout_marginBottom="40dp"
        />
    <!-- CardView for Ride Details -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"
        android:radius="8dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/fromLocationView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From: XYZ"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/toLocationView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To: ABC"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/priceView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price: $25"
                android:textSize="18sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/timeView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Time: 15:00"
                android:textSize="18sp"
                android:layout_marginBottom="8dp"
                />
            <TextView
                android:id="@+id/formatedDateView"
                android:textSize="16sp"
                android:textColor="#000000"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>









    <TextView
        android:id="@+id/paymentStatusMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payment Successful!"
        android:textSize="20sp"
        android:textColor="#4CAF50" />







</LinearLayout>